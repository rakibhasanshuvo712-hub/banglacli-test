# Copy this file to .env.local and fill in the values below.

# 1. Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# 2. The inbox that should receive new order notifications (your email).
ORDER_NOTIFICATION_EMAIL=you@example.com

# 3. A verified sender in Resend.
# For local testing, "Bloom & Stem <onboarding@resend.dev>" works, but it can
# only deliver to the email address you used to create your Resend account.
# After verifying your own domain, switch to e.g. "Bloom & Stem <orders@yourdomain.com>".
ORDER_FROM_EMAIL=Bloom & Stem <onboarding@resend.dev>

# 4. Audience ID for the "Bloom notes" newsletter (Resend → Contacts → Audiences).
# Newsletter signups return 503 until both this and RESEND_API_KEY are set.
RESEND_AUDIENCE_ID=your_audience_id_here
